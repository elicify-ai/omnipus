{
  "name": "@omnipus/ui",
  "version": "0.1.0",
  "type": "module",
  "description": "Omnipus UI — The Sovereign Deep design system",
  "main": "./dist/lib/index.cjs",
  "module": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js",
      "require": "./dist/lib/index.cjs"
    },
    "./styles.css": "./dist/lib/styles.css"
  },
  "files": [
    "dist/lib"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:lib": "tsc -b && vite build --config vite.lib.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "type-check": "tsc -b --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:touch-in-context": "playwright test -c playwright.touch-in-context.config.ts",
    "deadcode": "knip",
    "check:vitest-coverage": "node scripts/check-vitest-coverage.mjs",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build -o dist/storybook",
    "test:storybook": "node scripts/design-system/verification-run-tests.mjs storybook",
    "test:design-system:browser": "playwright test --config=playwright.design-system.config.ts browser.spec.ts",
    "test:design-system:screenshot": "playwright test --config=playwright.design-system.config.ts screenshot.spec.ts --reporter=line",
    "test:design-system:unit": "node --test scripts/design-system/*.test.mjs tests/design-system/*.test.mjs",
    "test:design-system:locks": "node --test tests/design-system-locks/*.test.mjs",
    "test:design-system:application-styles": "node --test tests/design-system/application-style.check.mjs",
    "verify:design-system": "node scripts/design-system/verification.mjs --manifests design-system/manifests --index dist/storybook/index.json --evidence test-results/design-system-components.json,test-results/design-system-storybook-chromium.json,test-results/design-system-storybook-firefox.json,test-results/design-system-storybook-webkit.json,test-results/design-system-browser.json",
    "measure:design-system-bundle": "node scripts/design-system/bundle-measure.mjs --dist dist/spa --output test-results/design-system-production-candidate.json",
    "audit:design-system-bundle": "node scripts/design-system/bundle-audit.mjs --baseline docs/internal/design/evidence/design-system-production-baseline-verified.json --candidate test-results/design-system-production-candidate.json --provenance docs/internal/design/evidence/design-system-production-provenance.json --output test-results/design-system-production-budget.json",
    "audit:design-system": "node -e \"require('fs').mkdirSync('test-results',{recursive:true})\" && node scripts/design-system-locks/policy.mjs > test-results/design-system-policy.json && node scripts/design-system-locks/audit.mjs --baseline design-system/enforcement/baseline.json --ledger design-system/enforcement/ledger.json --checkpoint \"$(node scripts/design-system-locks/current-checkpoint.mjs)\" --policy test-results/design-system-policy.json --report test-results/design-system-audit.json --coverage --index dist/storybook/index.json --evidence test-results/design-system-components.json,test-results/design-system-storybook-chromium.json,test-results/design-system-storybook-firefox.json,test-results/design-system-storybook-webkit.json,test-results/design-system-browser.json",
    "lint:design-system-locks": "node scripts/design-system-locks/lint.mjs",
    "tokens:generate": "node scripts/design-system/tokens.mjs",
    "tokens:check": "node scripts/design-system/tokens.mjs --check",
    "test:design-system:package": "npm run build:lib && node --test scripts/design-system/library-package.check.mjs",
    "test:design-system:components": "node scripts/design-system/verification-run-tests.mjs unit"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.14.27",
    "@assistant-ui/react-markdown": "^0.14.6",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@dagrejs/dagre": "^1.1.8",
    "@dnd-kit/core": "^6.3.1",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/list": "^6.1.21",
    "@fullcalendar/react": "^6.1.21",
    "@fullcalendar/timegrid": "^6.1.21",
    "@phosphor-icons/react": "^2.1.7",
    "@radix-ui/react-accordion": "^1.2.13",
    "@radix-ui/react-checkbox": "^1.3.4",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-dropdown-menu": "^2.1.17",
    "@radix-ui/react-label": "^2.1.9",
    "@radix-ui/react-popover": "^1.1.16",
    "@radix-ui/react-progress": "^1.1.9",
    "@radix-ui/react-select": "^2.3.0",
    "@radix-ui/react-separator": "^1.1.9",
    "@radix-ui/react-slider": "^1.4.0",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.14",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-virtual": "^3.14.6",
    "@uiw/react-codemirror": "^4.25.11",
    "@xyflow/react": "^12.11.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dompurify": "^3.4.12",
    "framer-motion": "^12.42.2",
    "immer": "^11.1.15",
    "katex": "^0.18.1",
    "mermaid": "^11.16.0",
    "pdfjs-dist": "6.2.108",
    "qrcode.react": "^4.2.0",
    "react-day-picker": "^9.14.0",
    "react-markdown": "^10.1.0",
    "react-shiki": "^0.11.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "rrule": "^2.8.1",
    "shiki": "^4.2.0",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@asyncapi/parser": "^3.6.0",
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.61.1",
    "@redocly/cli": "^2.39.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-vite-plugin": "^1.167.23",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "ajv": "8.20.0",
    "es-module-lexer": "3.0.2",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "^29.0.1",
    "knip": "^6.32.2",
    "openapi-typescript": "^7.13.0",
    "openapi-zod-client": "^1.18.3",
    "postcss": "8.5.28",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "storybook": "10.6.0",
    "tailwindcss": "^4.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "^8.1.5",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "4.1.11",
    "zod": "^3.25.76"
  },
  "pnpm": {
    "overrides": {
      "lodash": "^4.18.0",
      "dompurify": "^3.4.0",
      "@radix-ui/react-dismissable-layer": "^1.1.17",
      "@radix-ui/react-focus-scope": "1.1.13",
      "@radix-ui/react-focus-guards": "1.1.4",
      "axios": "^1.18.1",
      "undici": "^7.28.0",
      "js-yaml": "^4.2.0",
      "form-data": "^4.0.6"
    }
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    },
    "@radix-ui/react-dismissable-layer": "^1.1.17",
    "@radix-ui/react-focus-scope": "1.1.13",
    "@radix-ui/react-focus-guards": "1.1.4",
    "axios": "^1.18.1",
    "undici": "^7.28.0",
    "js-yaml": "^4.2.0",
    "form-data": "^4.0.6",
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "brace-expansion@^1.0.0": "^1.1.18"
  }
}
