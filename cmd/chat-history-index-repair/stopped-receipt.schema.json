{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "History index stopped observation (private operator evidence, not a lock)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "data_root", "instance_id", "previous_pid", "instance_binding_sha256", "pid_file_state", "checked_at", "inspection_method", "operator", "tool_commit"],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"const": "history_index_stopped_receipt"},
    "data_root": {"type": "string", "minLength": 1},
    "instance_id": {"type": "string", "pattern": "^hi1_[A-Za-z0-9_-]{43}$"},
    "previous_pid": {"type": "integer", "minimum": 1, "maximum": 4294967295},
    "instance_binding_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pid_file_state": {"enum": ["absent", "same_stale"]},
    "checked_at": {"type": "string", "format": "date-time"},
    "inspection_method": {"const": "native_process"},
    "operator": {"type": "string", "pattern": "\\S"},
    "tool_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
  }
}
