{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "History index instance binding (private operator evidence, not a lock)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "data_root", "pid_file", "root_identity", "previous_pid", "pid_file_sha256", "process_start_id", "process_executable", "captured_at", "operator", "tool_commit", "instance_id"],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"const": "history_index_instance_binding"},
    "data_root": {"type": "string", "minLength": 1},
    "pid_file": {"type": "string", "minLength": 1},
    "root_identity": {"type": "string", "minLength": 1},
    "previous_pid": {"type": "integer", "minimum": 1, "maximum": 4294967295},
    "pid_file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "process_start_id": {"type": "string", "minLength": 1},
    "process_executable": {"type": "string", "minLength": 1},
    "captured_at": {"type": "string", "format": "date-time"},
    "operator": {"type": "string", "pattern": "\\S"},
    "tool_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "instance_id": {"type": "string", "pattern": "^hi1_[A-Za-z0-9_-]{43}$"}
  }
}
