{
  "version": 1,
  "gateway": { "port": 19999, "dev_mode_bypass": true },
  "sandbox": { "audit_log": true, "tool_policies": { "spawn": "allow" } },
  "agents": { "defaults": { "default_model": { "provider": "minimax-coding-plan", "model": "MiniMax-M3.1-Flash-Preview" }, "auto_recap_enabled": true } },
  "providers": [
    {
      "provider": "minimax-coding-plan",
      "model": "MiniMax-M3.1-Flash-Preview",
      "api_base": "https://api.minimax.io/anthropic/v1",
      "api_key_ref": "MINIMAX_API_KEY"
    },
    {
      "provider": "openrouter",
      "model": "deepseek/deepseek-v4.1-flash",
      "api_base": "https://openrouter.ai/api/v1",
      "api_key_ref": "OPENROUTER_API_KEY"
    }
  ]
}
