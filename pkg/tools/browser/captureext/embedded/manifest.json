{
  "manifest_version": 3,
  "name": "Omnipus Live Browser Capture",
  "version": "1.0.17",
  "description": "Gateway-owned capture extension: streams the active tab's audio+video to the Omnipus gateway over WebRTC.",
  "key": "",
  "permissions": ["tabCapture", "tabs"],
  "background": {
    "service_worker": "sw.js"
  },
  "action": {
    "default_title": "Omnipus Capture"
  }
}
