# LibreOffice's Linux host libraries (office-preview spec §10): the system
# packages the official LibreOffice 26.8 build needs to start and convert
# documents headless. The one list for every Linux install route:
#   scripts/install.sh            embeds the four assignment lines verbatim
#   docker/Dockerfile.goreleaser  reads this file
#   .goreleaser.yaml              deb/rpm dependencies and recommends
# scripts/check-office-host-libs-sync.sh fails CI when they differ.
#
# Measured 2026-11-19 with ldd on every program and library of the
# LibreOffice 26.8.1.1 x86_64 build in debian:trixie-slim: with these
# installed, nothing is missing except the optional desktop, media and
# Java plugins (GTK/Qt/KDE VCL plugins and file pickers, the KDE config
# backend, GStreamer/GTK/Qt media playback, the Java bean), none of which
# a headless conversion loads. libx11-xcb1 was the gap that stopped the
# Docker image (dry run 44496809452).
#
# "a|b" lists package-name alternatives across distribution releases (for
# example Ubuntu 24.04's t64 names): the first one apt knows is installed.
OFFICE_DEB_LIBS="libx11-6 libx11-xcb1 libxext6 libxinerama1 libcairo2 libcups2t64|libcups2 libdbus-1-3 libfontconfig1 libfreetype6 libglib2.0-0t64|libglib2.0-0 libnss3 libnspr4"
OFFICE_DEB_RECOMMENDS="fonts-liberation"
OFFICE_RPM_LIBS="libX11 libX11-xcb libXext libXinerama cairo cups-libs dbus-libs fontconfig freetype glib2 nss nspr"
OFFICE_RPM_RECOMMENDS="liberation-fonts"
