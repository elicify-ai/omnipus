# Pinned official LibreOffice builds that the installer packaging ships
# (office-preview spec section 10: official build, pinned 26.8.x, SHA-256).
#
# One entry per platform that gets a packaged Office component. Windows has
# none: it uses operator registration (spec AD-12).
#
# The URLs are The Document Foundation's permanent archive (its "stable"
# folder drops a release when the next one ships). Each digest is the
# SHA-256 published on the archive's .mirrorlist page for that file, read on
# 2026-11-19; build-components.sh refuses any download that does not match.
# The Linux x86-64 entry must stay identical to
# scripts/office-preview-real/pins.env, so that the release ships the same
# LibreOffice the real-program tests run against; build-components.sh checks
# that before it builds.
LIBREOFFICE_VERSION=26.8.1.1
LIBREOFFICE_BASE_URL=https://downloadarchive.documentfoundation.org/libreoffice/old/26.8.1.1
# Folder inside the unpacked Linux packages that holds program/ and share/.
LIBREOFFICE_LINUX_DIR=opt/libreoffice26.8

LIBREOFFICE_ARCHIVE_linux_amd64=deb/x86_64/LibreOffice_26.8.1.1_Linux_x86-64_deb.tar.gz
LIBREOFFICE_SHA256_linux_amd64=30903df3b9f61360d9660cd707de48cd2831469114492a5008ed58a0ac77d044

LIBREOFFICE_ARCHIVE_linux_arm64=deb/aarch64/LibreOffice_26.8.1.1_Linux_aarch64_deb.tar.gz
LIBREOFFICE_SHA256_linux_arm64=1b069c20dd237f6decad3ea02cb02f39fdf458b03d09c2a9facb7b9b71e6a27a

LIBREOFFICE_ARCHIVE_darwin_arm64=mac/aarch64/LibreOffice_26.8.1.1_MacOS_aarch64.dmg
LIBREOFFICE_SHA256_darwin_arm64=ca074e0b13571efb30a31fc531c5f95e997030637325e5d5de92d67aefdf0dfc

LIBREOFFICE_ARCHIVE_darwin_amd64=mac/x86_64/LibreOffice_26.8.1.1_MacOS_x86-64.dmg
LIBREOFFICE_SHA256_darwin_amd64=4c7464313a529e9074400cbcdc894fc40ac4ef9421ded03b16b5a78d12cb155e
