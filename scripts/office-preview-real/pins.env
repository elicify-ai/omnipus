# Pinned LibreOffice for the "Office preview real programs" CI job (office
# preview spec section 10: official Linux build, pinned 26.8.x, SHA-256).
#
# The renderer's pins live in native/omnipus-pdfium/pins.env, which
# native/omnipus-pdfium/build.sh verifies itself.
#
# The URL is The Document Foundation's permanent archive: its "stable" folder
# drops a release when the next one ships, which would break this job.
# The digest is the published .sha256 next to the archive and was also computed
# independently from a full download on 2026-11-09. Anything else is refused.
LIBREOFFICE_VERSION=26.8.1.1
LIBREOFFICE_ARCHIVE=LibreOffice_26.8.1.1_Linux_x86-64_deb.tar.gz
LIBREOFFICE_URL=https://downloadarchive.documentfoundation.org/libreoffice/old/26.8.1.1/deb/x86_64/LibreOffice_26.8.1.1_Linux_x86-64_deb.tar.gz
LIBREOFFICE_SHA256=30903df3b9f61360d9660cd707de48cd2831469114492a5008ed58a0ac77d044
LIBREOFFICE_DIR=opt/libreoffice26.8
