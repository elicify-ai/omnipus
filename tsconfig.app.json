{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["node", "vite/client"]
  },
  // packages/ui/src/index.ts is the npm-publishable entry of @omnipus/ui and
  // is nothing but `export * from '../../../src/index'` — i.e. it lives in
  // this project's own module graph. It was previously checked by no gate at
  // all: this project included only "src", and packages/ui has no tsconfig.json
  // of its own (its `type-check` script, `tsc --noEmit`, therefore resolves
  // upward and is the silent no-op documented in tsconfig.json's header).
  // Listing it here means a break in the published surface — a renamed or
  // deleted src/index export — fails `npm run typecheck` instead of only
  // surfacing at `npm run build:lib` time.
  "include": ["src", "packages/ui/src"]
}
