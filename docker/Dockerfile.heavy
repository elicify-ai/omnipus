# ============================================================
# Stage 1: Build the SPA (frontend) into dist/spa/
# ============================================================
FROM node:24-alpine AS spa-builder

WORKDIR /src
COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

# ============================================================
# Stage 2: Build the Go binary with the SPA embedded
# ============================================================
FROM golang:1.26.5-alpine AS go-builder

RUN apk add --no-cache git make

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .

# pkg/gateway/embed.go has //go:embed all:spa and pkg/gateway/spa/ is
# gitignored. Mirror the Vite output from stage 1 into the embed target
# before `go build` reads the directive.
COPY --from=spa-builder /src/dist/spa /src/pkg/gateway/spa

RUN CGO_ENABLED=0 go build -tags goolm,stdjson \
    -ldflags "-s -w" \
    -o /out/omnipus ./cmd/omnipus

# ============================================================
# Stage 3: Runtime with browser + MCP support (Chromium, Python, uv)
# ============================================================
FROM node:24-alpine3.23

RUN apk add --no-cache \
  ca-certificates \
  curl \
  git \
  python3 \
  py3-pip \
  chromium \
  jq

# B2a: give the apk-installed Chromium a verified chrome.sha256 manifest
# in the on-disk layout pkg/tools/browser's resolver treats as the trusted
# "package Chrome" floor (ADR-052 D2 step 3 — findPackageChrome in
# package_chrome.go probes <dir(omnipus binary)>/../chromium/chrome +
# a companion chrome.sha256).
#
# DO NOT flip tools.browser.trust_path_chrome to make the resolver accept
# a bare $PATH Chrome instead — pkg/config/defaults.go seeds it false by
# design (SEC-ADR052-002) and ADR-052
# (docs/internal/architecture/ADR-052-phase1-security-review.md:26-32,146,185,198)
# is explicit that trusting ANY $PATH match for the container's whole life
# is a Blocker (planted-binary risk on shared/CI hosts); a $PATH Chrome is
# still recorded (WARN-BROWSER-007) but refused, exactly as it is on a
# native install.
#
# Chose apk chromium + a generated manifest over bundling real
# Chrome-for-Testing (scripts/cft-bundle.sh, the release-binary precedent)
# for THIS base image specifically: node:24-alpine3.23 is musl libc, and
# CfT's Linux build is glibc-linked. Alpine's glibc-compat shim (gcompat)
# is a documented, per-binary-fragile workaround — flagged unreliable
# specifically for headless/automation use, which is exactly this
# use case — and this dev pod has no Docker daemon to verify it
# empirically before shipping. Alpine's own chromium package is
# musl-native and already the binary this image ran before this fix, so
# generating chrome.sha256 for it satisfies the verified step-3 path with
# zero new binary-compatibility risk. Nothing apk-managed is removed —
# this only ADDS the verified layout alongside the existing
# /usr/lib/chromium install and its /usr/bin/chromium* symlinks.
#
# MUST be verified via a Fly remote build (no Docker daemon on this pod):
# after building, `docker run --rm <image> omnipus doctor` checks exactly
# this ("Package-bundled Chrome (ADR-052): missing required host shared
# libraries... and a SHA-256 mismatch" per its own --help) and should
# report the package Chrome clean, with no missing-shared-library or
# SHA-256-mismatch warning; a live browser_navigate tool call should show
# no WARN-BROWSER-007 and no managed chrome-for-testing download attempt.
#
# NOTE (live-verified post-deploy): this layout stages chrome FLAT at
# <root>/chrome — Alpine's apk chromium package has no chrome-linux64/
# extraction subdir, that subdir is a Chrome-for-Testing goreleaser-archive
# artifact only. This is layout #3 in
# pkg/tools/browser/package_chrome.go's binaryLayoutsForRoot (the flat
# layout install.sh's fallback also uses) and the runtime resolver
# (findPackageChrome) has always accepted it. A Fly deployment from this
# exact Dockerfile initially showed `omnipus doctor` reporting
# WARN-BROWSER-008 ("chrome binary is missing") despite the binary and a
# byte-for-byte-matching chrome.sha256 both being present — that was a bug
# in cmd/omnipus/internal/doctor/command.go's packageChromeBinaryPath
# (a duplicate, narrower layout probe that only checked chrome-linux64/
# chrome, out of sync with binaryLayoutsForRoot), now fixed there. Do NOT
# reintroduce a chrome-linux64/ subdir or symlink here to work around a
# doctor regression — that would be masking, not fixing, a future drift.
RUN set -eux; \
    mkdir -p /usr/local/chromium; \
    cp -rL /usr/lib/chromium/. /usr/local/chromium/; \
    test -f /usr/local/chromium/chrome; \
    test ! -L /usr/local/chromium/chrome; \
    sha256sum /usr/local/chromium/chrome | awk '{printf "%s  %s\n", $1, $2}' > /usr/local/chromium/chrome.sha256; \
    chmod -R go-w /usr/local/chromium; \
    chmod 0755 /usr/local/chromium

# Install uv (used by Python MCP servers)
RUN curl -LsSf https://astral.sh/uv/install.sh | sh && \
  ln -s /root/.local/bin/uv /usr/local/bin/uv && \
  ln -s /root/.local/bin/uvx /usr/local/bin/uvx && \
  uv --version

# Gateway defaults: 5000 = SPA + API, 5001 = preview iframes.
# See gateway.preview_port / preview_listener_enabled in pkg/config.
EXPOSE 5000 5001

# Inside a container the gateway must bind 0.0.0.0 so the published port
# mapping is reachable from the host. Same rationale as the minimal
# Dockerfile.
ENV OMNIPUS_GATEWAY_HOST=0.0.0.0

# Default sandbox mode = permissive inside Docker. The default unprivileged
# container seccomp profile blocks syscalls the hardened-exec path requires,
# causing "fork/exec /bin/sh: permission denied" with sandbox=enforce.
ENV OMNIPUS_SANDBOX_MODE=permissive

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -fsS http://localhost:5000/health || exit 1

# Copy binary
COPY --from=go-builder /out/omnipus /usr/local/bin/omnipus

# Reuse existing node user (UID/GID 1000) — rename to omnipus
RUN deluser node 2>/dev/null; delgroup node 2>/dev/null; \
    addgroup -g 1000 omnipus 2>/dev/null; \
    adduser -D -u 1000 -G omnipus -h /home/omnipus omnipus 2>/dev/null || true

USER omnipus

VOLUME /home/omnipus/.omnipus

# --allow-empty (-E) is required on first boot — the seed config has no
# providers configured yet. Once onboarding completes the providers list
# is populated and the flag is a no-op. Same default as the minimal image.
ENTRYPOINT ["omnipus"]
CMD ["start", "--allow-empty"]
