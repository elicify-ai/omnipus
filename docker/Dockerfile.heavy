# ============================================================
# Stage 1: Build the SPA (frontend) into dist/spa/
#
# --platform=$BUILDPLATFORM: the SPA build's output (static JS/CSS) is
# architecture-independent, so this stage always runs NATIVE to the build
# host rather than under buildx's QEMU emulation for the target platform.
# Same rationale as the go-builder stage below.
# ============================================================
FROM --platform=$BUILDPLATFORM node:24-alpine AS spa-builder

WORKDIR /src
COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

# ============================================================
# Stage 2: Build the Go binary with the SPA embedded
#
# --platform=$BUILDPLATFORM + GOOS/GOARCH: CGO_ENABLED=0 makes this a pure
# Go build, so it cross-compiles natively for the target platform instead
# of running the whole compiler under QEMU emulation. This keeps
# `docker buildx build --platform linux/amd64,linux/arm64` from paying the
# emulation tax on the two slowest stages (npm ci + go build) of a
# multi-arch build. TARGETOS/TARGETARCH are populated automatically by
# buildx; the runtime stage below still handles TARGETARCH itself for the
# Chrome-for-Testing download, which is arch-specific in a different way
# (a prebuilt binary fetch, not a compile).
# ============================================================
FROM --platform=$BUILDPLATFORM golang:1.26.6-alpine AS go-builder

RUN apk add --no-cache git make

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .

# pkg/gateway/embed.go has //go:embed all:spa and pkg/gateway/spa/ is
# gitignored. Mirror the Vite output from stage 1 into the embed target
# before `go build` reads the directive.
COPY --from=spa-builder /src/dist/spa /src/pkg/gateway/spa

ARG TARGETOS
ARG TARGETARCH
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -tags goolm,stdjson \
    -ldflags "-s -w" \
    -o /out/omnipus ./cmd/omnipus

# ============================================================
# Stage 3: Runtime with browser + MCP support (Chromium, Python, uv)
# ============================================================
FROM node:24-bookworm-slim

# glibc base, NOT Alpine/musl (changed 2026-08-03 — operator-reported
# regression: "we get captchas on google and youtube and streaming videos is
# not working at all").
#
# The previous image installed Alpine's `apk add chromium`. That build is
# open-source Chromium WITHOUT the proprietary codecs — no H.264, no AAC —
# which is exactly what YouTube and most of the web serve, so video loaded a
# player and then decoded nothing. It also fingerprints as an unusual browser,
# which compounds bot-detection challenges.
#
# Real Chrome-for-Testing is the fix (and what ADR-052 D2 already specifies as
# the runtime), but its Linux build is glibc-linked and cannot run on musl.
# Alpine's gcompat shim is documented as unreliable for exactly this
# headless/automation use, so the base image moves to Debian slim rather than
# trying to shim it.
#
# DISTRIBUTION NOTE (operator-approved 2026-08-03): Chrome-for-Testing is a
# Google binary under Google's terms, redistributed inside this MIT-licensed
# image. That is a deliberate product decision — the proprietary codecs are
# precisely what makes the browser usable — and is recorded here so it is not
# re-litigated as an accident.
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      git \
      jq \
      python3 \
      python3-pip \
      unzip \
      fonts-liberation \
      fonts-noto-color-emoji \
    && rm -rf /var/lib/apt/lists/*

# Chrome-for-Testing runtime shared libraries. Chrome links these directly;
# without them the binary exists but exits immediately, which the resolver
# reports as a missing-shared-library warning rather than anything obvious.
RUN apt-get update && apt-get install -y --no-install-recommends \
      libasound2 libatk-bridge2.0-0 libatk1.0-0 libatspi2.0-0 libcairo2 \
      libcups2 libdbus-1-3 libdrm2 libgbm1 libglib2.0-0 libnspr4 libnss3 \
      libpango-1.0-0 libx11-6 libxcb1 libxcomposite1 libxdamage1 libxext6 \
      libxfixes3 libxkbcommon0 libxrandr2 \
    && rm -rf /var/lib/apt/lists/*

# Fetch full Chrome-for-Testing (Stable) and lay it out exactly where the
# runtime resolver expects the trusted "package Chrome" (ADR-052 D2 step 3 —
# findPackageChrome probes <dir(omnipus binary)>/../chromium/chrome plus a
# companion chrome.sha256).
#
# Mirrors scripts/cft-bundle.sh's contract (same CfT manifest URL the runtime
# installer uses, full `chrome` build not chrome-headless-shell, chrome.sha256
# written BESIDE the binary). Kept inline rather than COPYing the script so the
# image builds from a bare context on any machine — this pod has no Docker
# daemon, so the build only ever runs remotely.
#
# Layout is FLAT (<root>/chrome), which is binaryLayoutsForRoot's layout #3 and
# accepted by findPackageChrome. Do NOT add a chrome-linux64/ subdir to satisfy
# a doctor regression — that masks drift instead of fixing it.
ARG TARGETARCH=amd64
RUN set -eux; \
    case "$TARGETARCH" in \
      amd64) CFT_PLATFORM=linux64 ;; \
      arm64) CFT_PLATFORM=linux-arm64 ;; \
      *) echo "unsupported TARGETARCH=$TARGETARCH" >&2; exit 1 ;; \
    esac; \
    URL="$(curl -fsSL https://googlechromelabs.github.io/chrome-for-testing/last-known-good-versions-with-downloads.json \
        | jq -r --arg p "$CFT_PLATFORM" '.channels.Stable.downloads.chrome[] | select(.platform==$p) | .url')"; \
    test -n "$URL"; \
    echo "fetching Chrome-for-Testing: $URL"; \
    curl -fsSL -o /tmp/chrome.zip "$URL"; \
    mkdir -p /tmp/cft /usr/local/chromium; \
    unzip -q /tmp/chrome.zip -d /tmp/cft; \
    cp -a "/tmp/cft/chrome-$CFT_PLATFORM/." /usr/local/chromium/; \
    rm -rf /tmp/chrome.zip /tmp/cft; \
    test -f /usr/local/chromium/chrome; \
    test ! -L /usr/local/chromium/chrome; \
    sha256sum /usr/local/chromium/chrome | awk '{printf "%s  %s\n", $1, $2}' > /usr/local/chromium/chrome.sha256; \
    chmod -R go-w /usr/local/chromium; \
    chmod 0755 /usr/local/chromium; \
    ln -sf /usr/local/chromium/chrome /usr/local/bin/chrome; \
    /usr/local/chromium/chrome --version

# Install uv (used by Python MCP servers)
RUN curl -LsSf https://astral.sh/uv/install.sh | sh && \
  ln -s /root/.local/bin/uv /usr/local/bin/uv && \
  ln -s /root/.local/bin/uvx /usr/local/bin/uvx && \
  uv --version

# Gateway defaults: 5000 = SPA + API, 5001 = preview iframes.
# See gateway.preview_port / preview_listener_enabled in pkg/config.
EXPOSE 5000 5001

# Inside a container the gateway must bind 0.0.0.0 so the published port
# mapping is reachable from the host. Same rationale as the minimal
# Dockerfile.
ENV OMNIPUS_GATEWAY_HOST=0.0.0.0

# Default sandbox mode = permissive inside Docker. The default unprivileged
# container seccomp profile blocks syscalls the hardened-exec path requires,
# causing "fork/exec /bin/sh: permission denied" with sandbox=enforce.
ENV OMNIPUS_SANDBOX_MODE=permissive

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -fsS http://localhost:5000/health || exit 1

# Copy binary
COPY --from=go-builder /out/omnipus /usr/local/bin/omnipus

# Reuse existing node user (UID/GID 1000) — rename to omnipus.
#
# Debian/shadow syntax, NOT BusyBox (the base moved Alpine → Debian slim,
# above). The previous `addgroup -g` / `adduser -D` form is BusyBox-only: on
# Debian those flags are invalid, and because the whole chain ended in
# `|| true` the failure would have been SILENT — leaving no omnipus user, so
# `USER omnipus` fails the build (or, worse on a variant that tolerates it,
# runs the gateway as root). Verified explicitly with `id omnipus` rather
# than trusting the exit status.
RUN set -eux; \
    userdel -r node 2>/dev/null || true; \
    groupdel node 2>/dev/null || true; \
    groupadd -g 1000 omnipus; \
    useradd -u 1000 -g omnipus -m -d /home/omnipus -s /usr/sbin/nologin omnipus; \
    id omnipus

USER omnipus

VOLUME /home/omnipus/.omnipus

# --allow-empty (-E) is required on first boot — the seed config has no
# providers configured yet. Once onboarding completes the providers list
# is populated and the flag is a no-op. Same default as the minimal image.
ENTRYPOINT ["omnipus"]
CMD ["start", "--allow-empty"]
