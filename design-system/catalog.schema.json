{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Omnipus design-system catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "classifications", "entries"],
  "properties": {
    "version": { "const": 1 },
    "classifications": {
      "type": "array",
      "const": ["foundations", "primitive", "composite", "domain", "application"]
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "classification", "exports", "publicExports", "publicTypes"],
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "classification": { "enum": ["foundations", "primitive", "composite", "domain", "application"] },
          "exports": { "$ref": "#/$defs/names" },
          "publicExports": { "$ref": "#/$defs/names" },
          "publicTypes": { "$ref": "#/$defs/names" }
        }
      }
    }
  },
  "$defs": {
    "names": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  }
}
