{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Omnipus application surface inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "surfaces", "sourceOwners"],
  "properties": {
    "version": { "const": 1 },
    "surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "source", "symbol", "lane", "entry", "verification"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["route", "redirect", "screen", "tab", "modal"] },
          "source": { "type": "string", "minLength": 1 },
          "symbol": { "type": "string", "minLength": 1 },
          "lane": { "type": "integer", "minimum": 1, "maximum": 8 },
          "entry": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "path"],
            "properties": {
              "type": { "enum": ["route", "activation"] },
              "path": { "type": "string", "minLength": 1 }
            }
          },
          "verification": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["checkId", "kind", "file", "test", "status"],
              "properties": {
                "checkId": { "type": "string", "minLength": 1 },
                "kind": { "enum": ["unit", "interaction", "browser", "reflow"] },
                "file": { "type": "string", "minLength": 1 },
                "test": { "type": "string", "minLength": 1 },
                "status": { "enum": ["executed", "planned"] }
              }
            }
          }
        }
      }
    },
    "sourceOwners": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "lane"],
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "lane": { "type": "integer", "minimum": 1, "maximum": 8 }
        }
      }
    }
  }
}
