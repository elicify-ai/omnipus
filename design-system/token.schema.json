{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Omnipus token source",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "tokens"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "tokens": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "css",
          "layer",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9-]*(\\.[a-zA-Z0-9-]+)+$"
          },
          "css": {
            "type": "string",
            "pattern": "^--[a-zA-Z][a-zA-Z0-9-]*$"
          },
          "layer": {
            "enum": [
              "primitive",
              "semantic",
              "component"
            ]
          },
          "kind": {
            "enum": [
              "color",
              "dimension",
              "number",
              "duration",
              "fontFamily",
              "fontWeight",
              "lineHeight",
              "shadow",
              "easing",
              "string"
            ]
          },
          "value": {
            "type": [
              "string",
              "number"
            ]
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "states": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "consumers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "responsive": {
            "type": "boolean"
          }
        },
        "oneOf": [
          {
            "required": [
              "value"
            ],
            "not": {
              "required": [
                "ref"
              ]
            }
          },
          {
            "required": [
              "ref"
            ],
            "not": {
              "required": [
                "value"
              ]
            }
          }
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "layer": {
                  "const": "component"
                }
              }
            },
            "then": {
              "required": [
                "owner",
                "purpose",
                "states",
                "consumers"
              ]
            }
          }
        ]
      }
    }
  }
}
