{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Omnipus component coverage manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "component",
    "exports",
    "category",
    "source",
    "documentation",
    "owner",
    "themes",
    "variants",
    "sizes",
    "states",
    "stories",
    "checks"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "component": {
      "type": "string",
      "minLength": 1
    },
    "exports": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "category": {
      "enum": [
        "primitive",
        "composite"
      ]
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "documentation": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "themes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "sizes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "states": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "stories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "exports"
        ],
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          },
          "exports": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "applicable"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "unit",
              "interaction",
              "axe",
              "keyboard",
              "browser",
              "pointer",
              "reduced-motion",
              "forced-colors",
              "root-size",
              "zoom",
              "reflow"
            ]
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "test": {
            "type": "string",
            "minLength": 1
          },
          "story": {
            "type": "string",
            "minLength": 1
          },
          "applicable": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "applicable": {
                  "const": true
                }
              }
            },
            "then": {
              "required": [
                "file",
                "test"
              ]
            },
            "else": {
              "required": [
                "reason"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "applicable": {
                  "const": true
                },
                "kind": {
                  "not": {
                    "const": "unit"
                  }
                }
              }
            },
            "then": {
              "required": [
                "story"
              ]
            }
          }
        ]
      }
    }
  }
}
